# ——— Supabase (Project Settings → API) ———
# Public, safe for the browser (protected by RLS):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. Used by scripts/create-admin.mjs and admin server actions.
# Never expose this in the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The only email allowed to sign in at /admin/login (trusted automatically).
ADMIN_EMAIL=admin@buildwithme.dev

# Public site URL — localhost in dev, your domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
